{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eduard-alloy/plumbix/blob/main/contracts/events.schema.json",
  "title": "Plumbix event",
  "description": "One event from GET /api/v1/events. It is the data of a Server-Sent Events frame whose id is the event's id and whose event name is its type. Ids increase and are never reused, so a client resumes with Last-Event-ID. repo_id, change_id and run_id are the filter keys of the stream; the payload depends on the type. Events describe facts the API also exposes; the API is the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "description": "A change was created, in state open.",
      "properties": {
        "type": {
          "const": "change.submitted"
        },
        "payload": {
          "$ref": "#/$defs/changeSubmitted"
        }
      },
      "required": [
        "repo_id",
        "change_id"
      ]
    },
    {
      "description": "A change moved from one state to another.",
      "properties": {
        "type": {
          "const": "change.state_changed"
        },
        "payload": {
          "$ref": "#/$defs/stateChanged"
        }
      },
      "required": [
        "repo_id",
        "change_id"
      ]
    },
    {
      "description": "The change landed on its target branch: Plumbix pushed it (run_id is the approved run that merged) or GitHub merged the pull request (strategy github; run_id is the latest run, absent when none had started).",
      "properties": {
        "type": {
          "const": "change.merged"
        },
        "payload": {
          "$ref": "#/$defs/changeMerged"
        }
      },
      "required": [
        "repo_id",
        "change_id"
      ]
    },
    {
      "description": "A pipeline run began. change_id and iteration are set for a change's run, absent for a plain branch run.",
      "properties": {
        "type": {
          "const": "run.started"
        },
        "payload": {
          "$ref": "#/$defs/runStarted"
        }
      },
      "required": [
        "repo_id",
        "run_id"
      ]
    },
    {
      "description": "One step of a run ended.",
      "properties": {
        "type": {
          "const": "step.finished"
        },
        "payload": {
          "$ref": "#/$defs/stepFinished"
        }
      },
      "required": [
        "repo_id",
        "run_id"
      ]
    },
    {
      "description": "A run ended. outcome is set when a change's run finished with a verdict.",
      "properties": {
        "type": {
          "const": "run.finished"
        },
        "payload": {
          "$ref": "#/$defs/runFinished"
        }
      },
      "required": [
        "repo_id",
        "run_id"
      ]
    },
    {
      "description": "The validators' combined judgment of an iteration. The change's state_changed event follows.",
      "properties": {
        "type": {
          "const": "verdict.issued"
        },
        "payload": {
          "$ref": "#/$defs/verdictIssued"
        }
      },
      "required": [
        "repo_id",
        "change_id",
        "run_id"
      ]
    },
    {
      "description": "A new alert is open. repo_id is set when the alert concerns one repo.",
      "properties": {
        "type": {
          "const": "alert.raised"
        },
        "payload": {
          "$ref": "#/$defs/alertRaised"
        }
      }
    },
    {
      "description": "An alert was closed, by a person or by Plumbix once its cause is gone.",
      "properties": {
        "type": {
          "const": "alert.resolved"
        },
        "payload": {
          "$ref": "#/$defs/alertResolved"
        }
      }
    },
    {
      "description": "A person approved a needs_human or escalated change; the change.state_changed event to approved follows in the same transaction.",
      "properties": {
        "type": {
          "const": "change.approved_by_person"
        },
        "payload": {
          "$ref": "#/$defs/approvedByPerson"
        }
      },
      "required": [
        "repo_id",
        "change_id"
      ]
    },
    {
      "description": "A step of a run began; the run lists it as running until step.finished.",
      "properties": {
        "type": {
          "const": "step.started"
        },
        "payload": {
          "$ref": "#/$defs/stepStarted"
        }
      },
      "required": [
        "repo_id",
        "run_id"
      ]
    },
    {
      "description": "Plumbix merged the target branch into a branch it created (a pipeline editor change) and pushed the result; the run.started event of the new iteration follows.",
      "properties": {
        "type": {
          "const": "change.refreshed"
        },
        "payload": {
          "$ref": "#/$defs/changeRefreshed"
        }
      },
      "required": [
        "repo_id",
        "change_id"
      ]
    },
    {
      "description": "An external validator step is waiting for a verdict from outside the pipeline; GET /api/v1/reviews/next hands out the brief until expires_at.",
      "properties": {
        "type": {
          "const": "review.requested"
        },
        "payload": {
          "$ref": "#/$defs/reviewRequested"
        }
      },
      "required": [
        "repo_id",
        "change_id",
        "run_id"
      ]
    },
    {
      "description": "A claim on an external review was given back because the reviewer never received the brief (its poll was cut off); the review is pending again and the next claim takes it.",
      "properties": {
        "type": {
          "const": "review.released"
        },
        "payload": {
          "$ref": "#/$defs/reviewClaimed"
        }
      },
      "required": [
        "repo_id",
        "change_id",
        "run_id"
      ]
    },
    {
      "description": "A reviewer took an external review and holds its token; the step's step.finished event follows when the verdict lands or the wait expires.",
      "properties": {
        "type": {
          "const": "review.claimed"
        },
        "payload": {
          "$ref": "#/$defs/reviewClaimed"
        }
      },
      "required": [
        "repo_id",
        "change_id",
        "run_id"
      ]
    }
  ],
  "$defs": {
    "stepStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "validator"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "validator": {
          "type": "boolean"
        },
        "stage": {
          "type": "string"
        }
      }
    },
    "reviewRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "step",
        "expires_at"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reviewClaimed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "reviewer"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changeRefreshed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_head",
        "head",
        "target_head"
      ],
      "properties": {
        "from_head": {
          "description": "The branch's head before the refresh.",
          "type": "string",
          "minLength": 1
        },
        "head": {
          "description": "The merge commit the branch now points at.",
          "type": "string",
          "minLength": 1
        },
        "target_head": {
          "description": "The target branch's head that the merge brought in.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changeState": {
      "type": "string",
      "enum": [
        "open",
        "running",
        "approved",
        "fix_requested",
        "rejected",
        "needs_human",
        "escalated",
        "merged",
        "closed"
      ]
    },
    "changeSubmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_branch",
        "target_branch",
        "title"
      ],
      "properties": {
        "source_branch": {
          "type": "string"
        },
        "target_branch": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "submitted_by": {
          "type": "string"
        },
        "pull_request": {
          "description": "The GitHub pull request the change mirrors (WU-054).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "url"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "stateChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/changeState"
        },
        "to": {
          "$ref": "#/$defs/changeState"
        }
      }
    },
    "changeMerged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "previous",
        "strategy"
      ],
      "properties": {
        "branch": {
          "description": "The target branch.",
          "type": "string"
        },
        "commit": {
          "description": "The commit now at the target's head.",
          "type": "string"
        },
        "previous": {
          "description": "The target's head before the merge.",
          "type": "string"
        },
        "strategy": {
          "description": "github: GitHub merged the pull request and Plumbix recorded it (WU-054).",
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase",
            "github"
          ]
        },
        "merged_by": {
          "description": "The GitHub login that merged the pull request; absent for Plumbix's own merges.",
          "type": "string"
        },
        "auto_merge": {
          "description": "GitHub merged on merged_by's behalf once the gate was green (auto-merge, WU-063): merged_by requested, nobody pressed. Absent or false for a merge a person pressed and for Plumbix's own merges.",
          "type": "boolean"
        }
      }
    },
    "runStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "pipeline": {
          "description": "The triggered pipeline under .plumbix/pipelines/ the run runs (WU-045); absent for the change pipeline.",
          "type": "string"
        }
      }
    },
    "stepFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "validator",
        "status",
        "exit_code",
        "duration_ms"
      ],
      "properties": {
        "step": {
          "type": "string"
        },
        "validator": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "timed_out",
            "errored",
            "skipped",
            "cancelled"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "attempts": {
          "description": "How many times the step ran; present when above one.",
          "type": "integer",
          "minimum": 1
        },
        "allowed_failure": {
          "description": "The failure was tolerated by the step's allow_failure.",
          "type": "boolean"
        },
        "reason": {
          "description": "Why a skipped step did not run.",
          "type": "string",
          "enum": [
            "needs",
            "paths"
          ]
        }
      }
    },
    "runFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "status",
        "head",
        "base"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "finished",
            "errored",
            "cancelled"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/changeState"
        },
        "error": {
          "type": "string"
        },
        "head": {
          "description": "The commit that was run; empty if the run failed before fetching.",
          "type": "string"
        },
        "base": {
          "description": "The merge base with the target; empty for a plain branch run.",
          "type": "string"
        }
      }
    },
    "verdictIssued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "outcome",
        "criteria",
        "findings",
        "reasons"
      ],
      "properties": {
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "$ref": "#/$defs/changeState"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "unmet",
                  "unknown"
                ]
              }
            }
          }
        },
        "findings": {
          "description": "How many findings the validators reported.",
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "alertRaised": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_id",
        "kind",
        "key",
        "message"
      ],
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bypass_commit",
            "token_expiry",
            "no_reviewer",
            "pipeline_unapproved",
            "gate_bypassed"
          ]
        },
        "key": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "alertResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_id",
        "kind",
        "key"
      ],
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bypass_commit",
            "token_expiry",
            "no_reviewer",
            "pipeline_unapproved",
            "gate_bypassed"
          ]
        },
        "key": {
          "type": "string"
        }
      }
    },
    "approvedByPerson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "head"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "head": {
          "description": "The validated commit the person approved.",
          "type": "string"
        },
        "by": {
          "description": "The person, as the surface knew them: the name given to the Approve action, or the GitHub login of the approving review (WU-060). Absent on events before it.",
          "type": "string"
        },
        "source": {
          "description": "Where the approval came from: plumbix (the Approve action) or github_review.",
          "type": "string",
          "enum": ["plumbix", "github_review"]
        }
      }
    }
  }
}
