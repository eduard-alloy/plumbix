# Plumbix secrets. Copy to .env and fill in. Never commit .env.
# Plumbix refuses to start if .env is readable by other users (chmod 600 .env).

# AI validator (Anthropic). Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model used by the AI validator. Default: claude-opus-5-5
# PLUMBIX_AI_MODEL=claude-opus-5-5

# Git hosts: personal access tokens with code read/write only.
# GitHub: fine-grained token, "Contents: Read and write" on the chosen repos.
PLUMBIX_GITHUB_TOKEN=
# Azure DevOps: token with the "Code (Read & write)" scope.
PLUMBIX_AZURE_DEVOPS_TOKEN=
